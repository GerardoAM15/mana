{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MANA",
  "mainBinaryName": "MANA",
  "version": "1.0.0",
  "identifier": "pe.edu.upeu.mana",
  "build": {
    "frontendDist": "../../frontend/dist/mana_frontend/browser",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "beforeDevCommand": "npm --prefix ../frontend start"
  },
  "app": {
    "windows": [
      {
        "title": "MANÁ",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Equipo MANÁ - UPeU",
    "shortDescription": "Pensiones, punto de venta y caja",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "perMachine"
      }
    }
  }
}
